{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "baseUrl": "./app",
    "paths": {
      "@adapters/*": ["adapters/*"],
      "@entities/*": ["entities/*"],
      "@errors/*": ["errors/*"],
      "@features/*": ["features/*"],
      "@ports/*": ["ports/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
